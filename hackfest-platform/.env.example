# Neon Postgres connection string (shared by compose, Render, and the worker).
# Keep sslmode=require; asyncpg needs it. Same value as .env / .env.worker.
DATABASE_URL=postgresql://USER:PASSWORD@ENDPOINT-PATH/turing-fest?sslmode=require&channel_binding=require
JWT_SECRET=pick-a-long-random-string
FLAG_SECRET=pick-a-different-long-random-string
# Bootstraps the first "admin" account only; per-admin accounts live in
# the DB afterwards and are managed in the admin UI's Admins tab.
ADMIN_PASSWORD=pick-a-strong-admin-password
# Comma-separated frontend origins for CORS. Leave unset ("*") when the
# frontend is served same-origin via nginx; set it if you host the frontend
# elsewhere.
#ALLOWED_ORIGINS=https://hackfest.example.com
# Per-team anti-starvation limits on POST /api/submissions (defaults shown).
#SUBMISSION_COOLDOWN_SECONDS=60
#SUBMISSIONS_PER_HOUR=20
