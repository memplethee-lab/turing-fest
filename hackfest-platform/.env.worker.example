# For the judge worker running OUTSIDE Render (see docker-compose.worker.yml).
# Get both values from the Render Dashboard:
#   Postgres: hackfest-postgres -> "Connect" tab -> External connection pool string
#   Key Value: hackfest-redis -> enable external connections -> external URL
DATABASE_URL=postgresql://hackfest:CHANGE_ME@d-xxxxxxxx-external-xxxx.pg.render.com:5432/hackfest?sslmode=require
REDIS_URL=rediss://:YOUR_KV_AUTH_TOKEN@red-xxxxxxxx.external-xxxx.render.com:6379/0
