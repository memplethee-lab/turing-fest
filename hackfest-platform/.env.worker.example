# For the judge worker running OUTSIDE Render (see docker-compose.worker.yml).
# DATABASE_URL: the same Neon string used everywhere.
# REDIS_URL: Render Key Value -> enable external connections -> external URL.
DATABASE_URL=postgresql://neondb_owner:CHANGE_ME@ep-xxxxxxxx-pooler.eastus2.azure.neon.tech/turing-fest?sslmode=require&channel_binding=require
REDIS_URL=rediss://:YOUR_KV_AUTH_TOKEN@red-xxxxxxxx.external-xxxx.render.com:6379/0
